{
  "name": "@git-native-cms/editor-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@fontsource/source-serif-4": "catalog:",
    "react-aria-components": "latest"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../tooling/scripts/copy-editor-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
