# GitHub App and OAuth (server-only)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Rotated encrypted cookie sessions
CMS_SESSION_SECRET=

# S3-compatible assets and immutable releases
CMS_S3_ENDPOINT=
CMS_S3_REGION=auto
CMS_S3_ACCESS_KEY_ID=
CMS_S3_SECRET_ACCESS_KEY=
CMS_ASSETS_BUCKET=git-native-cms-sandbox-assets
CMS_RELEASES_BUCKET=git-native-cms-sandbox-releases
CMS_PUBLIC_ASSETS_URL=
CMS_PUBLIC_RELEASES_URL=

# Opt-in, read-only R2 contract smoke test (`pnpm test:integration`)
CMS_R2_SMOKE=false

# Opt-in MinIO contract suite; CI enables this on a Docker runner
CMS_CONTAINER_TESTS=false
