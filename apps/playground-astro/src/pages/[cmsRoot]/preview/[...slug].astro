---
import { PreviewDemo } from "../../../components/PreviewDemo";
import "../../../styles/site.css";

const preview = Astro.params.cmsRoot === "__cms";
if (!preview) Astro.response.status = 404;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{preview ? "CMS preview · Astro playground" : "Not found"}</title>
  </head>
  <body>{preview ? <PreviewDemo client:load /> : <main><h1>Not found</h1></main>}</body>
</html>
