---
import "@git-native-cms/editor-ui/styles.css";
import { hostedRuntime } from "../../cms-runtime";
import { CmsDemo } from "../../components/CmsDemo";

const state = await hostedRuntime.editorState(Astro.request, Astro.params.path ?? "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CMS · Astro playground</title>
  </head>
  <body><CmsDemo state={state} client:load /></body>
</html>
