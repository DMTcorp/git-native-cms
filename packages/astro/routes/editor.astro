---
import "@git-native-cms/editor-ui/styles.css";
import { hostedRuntime } from "virtual:git-native-cms/runtime";
import { CmsEditor } from "virtual:git-native-cms/registry";

const state = await hostedRuntime.editorState(Astro.request, Astro.params.path ?? "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Content workspace</title>
  </head>
  <body><CmsEditor state={state} client:load /></body>
</html>
